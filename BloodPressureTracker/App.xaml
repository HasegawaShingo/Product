<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BloodPressureTracker"
             xmlns:converters="clr-namespace:BloodPressureTracker.Converters"
             x:Class="BloodPressureTracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EnumToListConverter x:Key="EnumToListConverter" />
            <converters:TimeCategoryToStringConverter x:Key="TimeCategoryToStringConverter" />
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:BoolInverterConverter x:Key="BoolInverterConverter" />
            <converters:WeekRangeConverter x:Key="WeekRangeConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
