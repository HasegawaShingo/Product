<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BloodPressureTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BloodPressureTracker"
    xmlns:views="clr-namespace:BloodPressureTracker.Views"
    FlyoutBehavior="Disabled"
    Title="血圧記録"
    Shell.TabBarIsVisible="True">

    <TabBar>
        <Tab Title="一覧">
            <ShellContent Route="list" ContentTemplate="{DataTemplate views:ListPage}" />
        </Tab>
        <Tab Title="統計">
            <ShellContent Route="statistics" ContentTemplate="{DataTemplate views:StatisticsPage}" />
        </Tab>
    </TabBar>

    <ShellContent Route="record" ContentTemplate="{DataTemplate views:RecordPage}" />

</Shell>
